{
  "name": "premavision",
  "version": "2.0.0",
  "private": true,
  "description": "premavision.net: Prema Vision LLC marketing site",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/routines.mjs && tsc --noEmit && NODE_ENV=production vite build && NODE_ENV=production vite build --ssr src/entry-server.tsx && NODE_ENV=production node scripts/prerender.mjs",
    "build:drafts": "SHOW_DRAFTS=1 npm run build",
    "preview": "vite preview",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/premavision/premavision.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "qrcode-generator": "^1.4.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^4.5.14"
  }
}
